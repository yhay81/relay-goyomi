{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-goyomi",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "relay-goyomi.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["23 19 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relay-goyomi",
      "database_id": "0cde7b51-e214-44cc-9734-45cd0e76d011",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
